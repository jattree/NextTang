# Copy this file to .env.local and change paths for your machine.
# .env.local is ignored by Git. Do not put licenses or credentials here.

NEXTTANG_TOOLCHAIN=oss
NEXTTANG_TARGET=console138k
NEXTTANG_PROFILE=release

# Source each toolchain's environment before invoking make. These paths are
# recorded so `make doctor` can provide targeted setup hints.
NEXTTANG_GOWIN_HOME=/opt/Gowin/Gowin_V1.9.12.02_SP1
NEXTTANG_OSS_CAD_SUITE=/opt/oss-cad-suite/2026-08-02
