// Tang Console 138K NEO, GW5AST-138C PG484. Processor with display output.
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC "debug_uart_tx" E18;
IO_PORT "debug_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_clk_p" G15;
IO_PORT "tmds_clk_p" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_clk_n" G16;
IO_PORT "tmds_clk_n" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_p[0]" J14;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_n[0]" H14;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_p[1]" J15;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_n[1]" H15;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_p[2]" K17;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_d_n[2]" J17;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D DRIVE=8;

// Source-side 5V presence on the HDMI connector. Sipeed report this has to be
// driven high for a sink to see the output. Every earlier image left it
// unconstrained and therefore floating.
IO_LOC "tmds_psv" K14;
IO_PORT "tmds_psv" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Z80 bus on PMOD1 for a logic analyser. Ground reference is connector pins 3
// and 4. PMOD1_IO0 and IO1 are W19 and W20 in bank 4 and are left alone because
// that bank's voltage is not established here; IO2 to IO7 are bank 2, the same
// bank as the status UART pin, which is known to drive 3.3V logic.
//
//   probe   signal        PMOD1     FPGA   connector pin
//   0       cpu_clock     IO2       F19    9
//   1       m1_n          IO3       F20    10
//   2       mreq_n        IO4       E22    7
//   3       iorq_n        IO5       D22    8
//   4       wr_n          IO6       E21    5
//   5       interrupt_n   IO7       D21    6
IO_LOC "probe[0]" F19;
IO_PORT "probe[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "probe[1]" F20;
IO_PORT "probe[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "probe[2]" E22;
IO_PORT "probe[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "probe[3]" D22;
IO_PORT "probe[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "probe[4]" E21;
IO_PORT "probe[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "probe[5]" D21;
IO_PORT "probe[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Scan codes from the BL616. Read only: this pin group is shared with JTAG and
// the debugger drives it while a bitstream is loaded.
IO_LOC "bl616_uart_rx" V14;
IO_PORT "bl616_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Calibration input for the keyboard diagnostic: the host FT232R already
// drives PMOD0 IO2, so a byte sent from the laptop proves the "byte seen"
// latch and its crossing work before any conclusion is drawn from V14.
IO_LOC "loopback_uart_rx" G21;
IO_PORT "loopback_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
