// The memory PLL, DLL and the controller clock divider sit beside the DDR3
// bank, as in console138k_ddr3.cst. Left to the placer, calibration never
// completes.
INS_LOC "memory_pll/reference_pll/u_pll/PLL_inst" PLL_L[0];
INS_LOC "ddr3/gw3_top/u_ddr_phy_top/u_dll" DDRDLLM_BL;
INS_LOC "ddr3/gw3_top/u_ddr_phy_top/fclkdiv" LEFTSIDE[4];

// Pinning the memory PLL moves the video PLL. Wherever the placer then puts it,
// the PLL reports lock but HDMI carries no signal, so it stays at the site the
// block-RAM image uses.
INS_LOC "video_pll/pll" PLL_B[2];

// Every machine clock on a global clock wire. The core does half its work
// on the opposite edge of a related clock and assumes balanced global
// trees. With the CLKDIV-derived 7 and 14 MHz on local wiring, the ULA's
// screen fetches missed hold by up to 0.22 ns once DDR3 shared the device.
CLOCK_LOC "clock_28" BUFG = CLK;
CLOCK_LOC "clock_28_n" BUFG = CLK;
CLOCK_LOC "clock_14" BUFG = CLK;
CLOCK_LOC "clock_7" BUFG = CLK;
